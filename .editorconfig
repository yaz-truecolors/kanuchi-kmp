root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
ktlint_standard_filename = disabled
# @Composable 関数の PascalCase 命名を許可する
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml}]
indent_size = 2

# e2e/（Playwright のスモークテスト）の JavaScript と npm が生成する JSON は 2 スペース
[e2e/**.{js,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[**/build/**/*.{kt,kts}]
# Compose リソースジェネレータ等の自動生成コードは lint 対象外にする
ktlint_standard = disabled
