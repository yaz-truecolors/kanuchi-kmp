{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(./supabase/tests/run.sh)",
      "Bash(supabase status)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(.claude/skills/local-ui-check/scripts/build-local-dist.sh)",
      "Bash(.claude/skills/local-ui-check/scripts/serve-local-dist.sh)",
      "Bash(python3 -I .claude/skills/local-ui-check/scripts/login_link.py *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./local.properties)"
    ]
  }
}
