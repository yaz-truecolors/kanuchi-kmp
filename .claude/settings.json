{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(./supabase/tests/run.sh)",
      "Bash(supabase status)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(.claude/skills/local-ui-check/scripts/build-local-dist.sh)",
      "Bash(.claude/skills/local-ui-check/scripts/serve-local-dist.sh)",
      "Bash(python3 -I .claude/skills/local-ui-check/scripts/login_link.py *)",
      "Bash(python3 -I .claude/skills/pr-review/scripts/post_review.py --dry-run *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./local.properties)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ktlint-format.sh",
            "timeout": 120,
            "statusMessage": "ktlintFormat を実行中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-stop.sh",
            "timeout": 300,
            "statusMessage": "ktlintCheck・detekt を実行中..."
          }
        ]
      }
    ]
  }
}
