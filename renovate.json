{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Kotlin Gradle プラグインにダウンロードさせる Node.js のバージョン（gradle/libs.versions.toml の nodejs）",
            "managerFilePatterns": [
                "/^gradle/libs\\.versions\\.toml$/"
            ],
            "matchStrings": [
                "\\nnodejs = \"(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "node",
            "datasourceTemplate": "node-version"
        },
        {
            "customType": "regex",
            "description": "GitHub Actions で使う Supabase CLI のバージョン（.github/workflows/*.yml の SUPABASE_CLI_VERSION。ci.yml と supabase-deploy.yml を同じPRで更新する）",
            "managerFilePatterns": [
                "/^\\.github/workflows/[^/]+\\.ya?ml$/"
            ],
            "matchStrings": [
                "SUPABASE_CLI_VERSION: \"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?"
            ],
            "depNameTemplate": "supabase/cli",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
        }
    ]
}
